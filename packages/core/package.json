{
  "name": "@traq-markdown-parser/core",
  "version": "0.1.0",
  "private": true,
  "description": "core Markdown contracts and HTML rendering.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/traq-markdown-parser/core.git"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/ast.d.ts",
      "import": "./dist/ast.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "import": "./dist/renderer/index.js"
    },
    "./definitions": {
      "types": "./dist/renderer/definitions.d.ts",
      "import": "./dist/renderer/definitions.js"
    },
    "./html": {
      "types": "./dist/renderer/html.d.ts",
      "import": "./dist/renderer/html.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.js"
    },
    "./codegen/nodes": "./scripts/contracts/nodes.ts",
    "./codegen/schema": "./scripts/contracts/schema.ts",
    "./codegen/javascript": "./scripts/contracts/javascript.ts",
    "./codegen/go": "./scripts/contracts/go.ts"
  },
  "files": [
    "dist",
    "LICENSE",
    "scripts/contracts"
  ],
  "scripts": {
    "build": "node ../../node_modules/@typescript/native/bin/tsc -p typescript/tsconfig.build.json",
    "test": "bun test ./typescript/tests",
    "test:go": "go -C go test ./...",
    "typecheck": "node ../../node_modules/@typescript/native/bin/tsc -p typescript/tsconfig.json"
  },
  "engines": {
    "node": ">=24"
  }
}
