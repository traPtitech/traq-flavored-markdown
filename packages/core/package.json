{
  "name": "@traq-markdown-engine/core",
  "version": "0.1.1",
  "description": "core Markdown contracts and HTML rendering.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uni-kakurenbo/traq-markdown-engine.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/ast.d.ts",
      "import": "./dist/ast.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "import": "./dist/renderer/index.js"
    },
    "./definitions": {
      "types": "./dist/renderer/definitions.d.ts",
      "import": "./dist/renderer/definitions.js"
    },
    "./html": {
      "types": "./dist/renderer/html.d.ts",
      "import": "./dist/renderer/html.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run ../../scripts/tsc.ts -p typescript/tsconfig.build.json",
    "test": "bun test ./typescript/tests",
    "test:go": "go -C go test ./...",
    "typecheck": "bun run ../../scripts/tsc.ts -p typescript/tsconfig.json"
  },
  "engines": {
    "node": ">=24"
  }
}
