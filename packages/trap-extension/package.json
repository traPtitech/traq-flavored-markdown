{
  "name": "@traq-markdown-parser/trap-extension",
  "version": "0.1.0",
  "private": true,
  "description": "trap-extension Markdown contracts and HTML rendering.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/traq-markdown-parser/trap-extension.git"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./nodes": {
      "types": "./dist/generated/trap.d.ts",
      "import": "./dist/generated/trap.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "import": "./dist/renderer/index.js"
    },
    "./stamp-effects": {
      "types": "./dist/renderer/stamp-effects.d.ts",
      "import": "./dist/renderer/stamp-effects.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p typescript/tsconfig.json",
    "generate:bindings": "bun run ../../scripts/generate-bindings.ts trap-extension",
    "typecheck": "tsc -p typescript/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@traq-markdown-parser/commonmark": "workspace:*",
    "@traq-markdown-parser/core": "workspace:*"
  },
  "peerDependencies": {
    "@traq-markdown-parser/commonmark": "0.1.0",
    "@traq-markdown-parser/core": "0.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
