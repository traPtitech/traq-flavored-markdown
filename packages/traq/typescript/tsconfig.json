{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "../../..",
    "strict": false,
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "**/*.ts",
    "../examples/typescript/*.ts",
    "renderer/**/*.ts",
    "tests/rendering/types.ts"
  ]
}
