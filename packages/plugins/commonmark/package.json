{
  "name": "@traq-flavored-markdown/commonmark-plugin",
  "version": "0.1.7",
  "type": "module",
  "description": "commonmark Markdown contracts and HTML rendering.",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/traPtitech/traq-flavored-markdown.git",
    "directory": "packages/plugins/commonmark"
  },
  "exports": {
    "./nodes": {
      "types": "./dist/generated/nodes.d.ts",
      "import": "./dist/generated/nodes.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "import": "./dist/renderer/index.js"
    },
    "./highlight": {
      "types": "./dist/renderer/highlight.d.ts",
      "import": "./dist/renderer/highlight.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "bun run ../../../scripts/tsc.ts -p typescript/tsconfig.build.json",
    "generate:bindings": "bun run ../../../scripts/generate-bindings.ts commonmark-plugin",
    "typecheck": "bun run ../../../scripts/tsc.ts -p typescript/tsconfig.json"
  },
  "peerDependencies": {
    "@traq-flavored-markdown/core": "0.1.7",
    "highlight.js": "11.12.0"
  },
  "devDependencies": {
    "@traq-flavored-markdown/core": "workspace:*",
    "highlight.js": "11.12.0"
  },
  "peerDependenciesMeta": {
    "highlight.js": {
      "optional": true
    }
  }
}
