{
  "name": "@traq-flavored-markdown/traq-plugin",
  "version": "0.1.5",
  "description": "traQ-specific Markdown contracts and HTML rendering.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/traPtitech/traq-flavored-markdown.git",
    "directory": "packages/plugins/traq"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./nodes": {
      "types": "./dist/generated/trap.d.ts",
      "import": "./dist/generated/trap.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "import": "./dist/renderer/index.js"
    },
    "./stamp-effects": {
      "types": "./dist/renderer/stamp-effects.d.ts",
      "import": "./dist/renderer/stamp-effects.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run ../../../scripts/tsc.ts -p typescript/tsconfig.build.json",
    "generate:bindings": "bun run ../../../scripts/generate-bindings.ts traq-plugin",
    "typecheck": "bun run ../../../scripts/tsc.ts -p typescript/tsconfig.json"
  },
  "devDependencies": {
    "@traq-flavored-markdown/commonmark-plugin": "workspace:*",
    "@traq-flavored-markdown/core": "workspace:*"
  },
  "peerDependencies": {
    "@traq-flavored-markdown/commonmark-plugin": "0.1.5",
    "@traq-flavored-markdown/core": "0.1.5"
  },
  "engines": {
    "node": ">=24"
  }
}
