{
  "name": "@traq-flavored-markdown/traq-plugin",
  "version": "0.1.7",
  "description": "traQ-specific Markdown contracts and HTML rendering.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/traPtitech/traq-flavored-markdown.git",
    "directory": "packages/plugins/traq"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "sideEffects": [
    "./dist/index.css"
  ],
  "type": "module",
  "exports": {
    "./nodes": {
      "types": "./dist/generated/nodes.d.ts",
      "import": "./dist/generated/nodes.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "import": "./dist/renderer/index.js"
    },
    "./index.css": "./dist/index.css",
    "./styles/*": "./styles/*.scss"
  },
  "files": [
    "dist",
    "LICENSE",
    "styles"
  ],
  "scripts": {
    "build": "bun run build:ts && bun run build:styles",
    "generate:bindings": "bun run ../../../scripts/generate-bindings.ts traq-plugin",
    "typecheck": "bun run ../../../scripts/tsc.ts -p typescript/tsconfig.json",
    "build:ts": "bun run ../../../scripts/tsc.ts -p typescript/tsconfig.build.json",
    "build:styles": "sass --no-source-map styles/base.scss dist/index.css"
  },
  "devDependencies": {
    "@traq-flavored-markdown/core": "workspace:*",
    "sass": "1.106.1"
  },
  "peerDependencies": {
    "@traq-flavored-markdown/core": "0.1.7"
  },
  "engines": {
    "node": ">=24"
  }
}
