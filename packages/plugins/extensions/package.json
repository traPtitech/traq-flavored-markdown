{
  "name": "@traq-flavored-markdown/extensions-plugin",
  "version": "0.1.7",
  "type": "module",
  "description": "Markdown table, math, mark, strikethrough and linkify extensions.",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/traPtitech/traq-flavored-markdown.git",
    "directory": "packages/plugins/extensions"
  },
  "exports": {
    "./nodes": {
      "types": "./dist/generated/nodes.d.ts",
      "import": "./dist/generated/nodes.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "import": "./dist/renderer/index.js"
    },
    "./math": {
      "types": "./dist/renderer/math.d.ts",
      "import": "./dist/renderer/math.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "bun run ../../../scripts/tsc.ts -p typescript/tsconfig.build.json",
    "generate:bindings": "bun run ../../../scripts/generate-bindings.ts extensions-plugin",
    "typecheck": "bun run ../../../scripts/tsc.ts -p typescript/tsconfig.json"
  },
  "peerDependencies": {
    "@traq-flavored-markdown/core": "0.1.7"
  },
  "devDependencies": {
    "@traq-flavored-markdown/core": "workspace:*",
    "@types/katex": "0.16.8"
  },
  "dependencies": {
    "katex": "0.18.7"
  }
}
