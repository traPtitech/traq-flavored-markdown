{
  "name": "corpus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build viewer",
    "collect": "bun run --bun cli/collect.ts",
    "compare": "bun run --bun cli/compare.ts",
    "report": "bun run build && bun run --bun cli/report.ts",
    "test": "bun run testing/run.ts",
    "test:go": "bun run testing/go.ts",
    "generate:protocol": "bun run protocol/generate.ts",
    "check:protocol": "bun run protocol/generate.ts --check",
    "typecheck": "bun run --bun ../../scripts/tsc.ts -p tsconfig.browser.json && bun run --bun ../../scripts/tsc.ts -p tsconfig.json"
  },
  "dependencies": {
    "jest-diff": "30.5.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4"
  }
}
