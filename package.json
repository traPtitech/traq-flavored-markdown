{
  "name": "traq-flavored-markdown",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/traPtitech/traq-flavored-markdown.git"
  },
  "workspaces": [
    "packages/core",
    "packages/plugins/*",
    "packages/sdk",
    "tools/*"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "build:typescript": "bun run scripts/build/typescript.ts",
    "build:corpus": "bun run --cwd tools/corpus build",
    "check": "bun run format:check && bun run lint:check && bun run check:architecture && bun run scripts/build.ts --check-generated && bun run build:corpus && bun run typecheck && bun run test && bun run lint:rust && bun run check:package && bun run check:go-consumer",
    "check:architecture": "bun run scripts/checks/architecture.ts",
    "check:go-consumer": "bun run scripts/checks/go-consumer.ts",
    "check:generated": "bun run scripts/checks/generated.ts",
    "check:package": "bun run scripts/checks/package-contents.ts",
    "corpus:collect": "bun run --cwd tools/corpus collect",
    "corpus:compare": "bun run --cwd tools/corpus compare",
    "corpus:report": "bun run --cwd tools/corpus report",
    "format": "bun run format:prettier && bun run format:rust && bun run format:go",
    "format:check": "bun run format:prettier:check && bun run format:rust:check && bun run format:go:check",
    "format:go": "bun run scripts/gofmt.ts",
    "format:go:check": "bun run scripts/gofmt.ts --check",
    "format:prettier": "prettier --cache --write .",
    "format:prettier:check": "prettier --cache --check .",
    "format:rust": "cargo fmt --all",
    "format:rust:check": "cargo fmt --all --check",
    "generate:bindings": "bun run scripts/generate-bindings.ts",
    "husky:prepare": "husky",
    "lint": "eslint --fix --cache .",
    "lint:check": "eslint --cache --max-warnings=0 .",
    "lint:rust": "cargo clippy --locked --workspace --all-targets --all-features -- -D warnings",
    "release": "bun run scripts/release.ts",
    "test": "bun run test:typescript && bun run test:corpus && bun run test:rust && bun run test:go && bun run test:corpus:go && bun run test:browser",
    "test:corpus": "bun run --cwd tools/corpus test",
    "test:go": "bun run scripts/testing/go.ts",
    "test:rust": "cargo test --locked --workspace --all-features",
    "test:typescript": "bun run scripts/testing/run.ts",
    "test:unit": "bun run scripts/testing/run.ts unit",
    "test:assembly": "bun run scripts/testing/run.ts assembly",
    "test:codegen": "bun run scripts/testing/run.ts codegen",
    "test:workspace": "bun run scripts/testing/run.ts workspace",
    "test:wasm": "bun run scripts/testing/run.ts wasm",
    "typecheck": "bun run scripts/typecheck.ts",
    "test:browser": "playwright test --config tests/browser/playwright.config.ts",
    "test:browser:serve": "bun run --cwd tools/corpus vite ../.. --config ../../tests/browser/vite.config.ts --port 4178 --host 127.0.0.1",
    "test:corpus:go": "bun run --cwd tools/corpus test:go"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/bun": "1.4.3",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "packageManager": "bun@1.4.3",
  "overrides": {
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@typescript-eslint/project-service": "8.72.0",
    "@typescript-eslint/scope-manager": "8.72.0",
    "@typescript-eslint/tsconfig-utils": "8.72.0",
    "@typescript-eslint/type-utils": "8.72.0",
    "@typescript-eslint/types": "8.72.0",
    "@typescript-eslint/typescript-estree": "8.72.0",
    "@typescript-eslint/utils": "8.72.0",
    "@typescript-eslint/visitor-keys": "8.72.0",
    "argparse": "3.0.3",
    "eslint": "10.13.0",
    "markdown-it": "15.0.3",
    "sass": "1.106.1",
    "vite-plugin-singlefile": "2.3.4",
    "vite": "8.3.5"
  }
}
